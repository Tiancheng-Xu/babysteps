{
  "schemaVersion": 2,
  "appId": "babysteps",
  "perRouteEventBudget": 40,
  "vitalsReadyMark": "babysteps.web-vitals.ready",
  "vitalsReadyTimeoutMs": 10000,
  "representativeInteractionCpuSlowdownRate": 6,
  "representativeInteractionSettleFrames": 2,
  "maxRoutesPerQuotaWindow": 3,
  "quotaWindowPauseMs": 61000,
  "telemetryAttemptTimeoutMs": 3000,
  "telemetryResponseTimeoutMs": 15000,
  "allowedLocalOrigins": ["http://127.0.0.1", "http://localhost"],
  "routes": [
    { "path": "/", "heading": "BabySteps · 成长星球" },
    { "path": "/tasks", "heading": "成长任务市集" },
    { "path": "/parent", "heading": "家长成长中心" },
    { "path": "/keepsakes", "heading": "星宝纪念馆" },
    { "path": "/provider", "heading": "机构与育婴师控制台" },
    { "path": "/exchange", "heading": "BabyCoin 兑换" },
    { "path": "/profile", "heading": "个人中心" },
    { "path": "/performance", "heading": "BabySteps 性能观测站" },
    { "path": "/evidence", "heading": "链上工作证据" }
  ],
  "representativeInteraction": {
    "route": "/performance",
    "expectedMetric": "INP",
    "steps": [
      { "action": "type", "role": "textbox", "name": "页面路径", "value": "/performance" },
      { "action": "click", "role": "button", "name": "应用筛选" },
      { "action": "click", "role": "button", "name": "历史快照" }
    ],
    "assertions": [
      { "urlSearchParam": "mode", "equals": "history" }
    ]
  },
  "spaNavigation": {
    "route": "/",
    "role": "link",
    "name": "成长任务",
    "expectedPath": "/tasks",
    "expectedMetric": "spa.route.duration"
  },
  "safeBusinessInteractions": [
    {
      "id": "sepolia-uniswap-quote",
      "route": "/exchange",
      "steps": [
        { "action": "fill", "role": "textbox", "name": "输入数量", "value": "1" },
        { "action": "click", "role": "button", "name": "读取链上报价" }
      ],
      "settledRole": "status",
      "settledNotText": "正在",
      "expectedMetric": "web3.uniswap.quote",
	  "expectedMetrics": ["contract.read", "web3.uniswap.quote"],
      "safety": "read-only-sepolia",
      "acceptedOutcomes": ["success", "failure"]
    }
  ],
  "safeReadOnlySettles": [
    {
      "id": "sepolia-marketplace-read",
      "route": "/tasks",
      "settledRole": "status",
      "settledNotText": "正在读取",
      "expectedMetrics": ["rpc.read", "web3.rpc.read"],
      "safety": "read-only-sepolia"
    }
  ],
  "safeResourceProbeRoute": "/performance",
  "requiredMetrics": [
    "LCP",
    "CLS",
    "INP",
    "FCP",
    "TTFB",
    "navigation.request_wait",
    "navigation.download",
    "navigation.dom_ready",
    "navigation.window_load",
    "resource.fetch.duration",
    "resource.xhr.duration",
    "resource.stylesheet.duration",
    "resource.image.duration",
    "resource.font.duration",
    "resource.script.duration",
    "resource.duration",
    "spa.route.duration",
    "ssr.shell.duration",
    "hydration.duration",
    "contract.read",
    "rpc.read",
    "web3.rpc.read",
    "web3.uniswap.quote"
  ],
  "requiredWeb3Metrics": [
    "contract.read",
    "rpc.read",
    "web3.rpc.read",
    "web3.uniswap.quote"
  ],
  "businessMetrics": [
    "business.growth.activity",
    "business.growth.transfer",
    "business.notebook.write",
    "business.babycoin.activity",
    "business.marketplace.approve",
    "business.marketplace.buy",
    "business.marketplace.content_unlock",
    "business.marketplace.completion_submit",
    "business.provider.create",
    "business.owner.approve",
    "business.owner.reject",
    "business.owner.completion_confirm",
    "business.keepsake.draw",
    "business.keepsake.fuse",
    "business.keepsake.recover",
    "business.exchange.quote",
    "business.exchange.swap",
    "business.identity.login",
    "business.identity.session",
    "business.profile.write"
  ],
  "implementedFeatureJourneys": [
    { "journeyId": "NAV-01", "route": "*", "roleAlias": "public", "operation": "navigation", "transaction": "none", "manualSignature": false, "finalProof": ["route-readback", "no-pageerror"], "compensation": "none" },
    { "journeyId": "WALLET-01", "route": "/", "roleAlias": "parent-a", "operation": "wallet-connect", "transaction": "sepolia-read", "manualSignature": true, "finalProof": ["chain-id", "wallet-readback"], "compensation": "disconnect-wallet" },
    { "journeyId": "GROWTH-01", "route": "/", "roleAlias": "parent-a", "operation": "growth-meal", "businessMetric": "business.growth.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "points-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "GROWTH-02", "route": "/", "roleAlias": "parent-a", "operation": "growth-walk", "businessMetric": "business.growth.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "points-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "GROWTH-03", "route": "/", "roleAlias": "parent-a", "operation": "growth-read", "businessMetric": "business.growth.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "points-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "TRANSFER-01", "route": "/", "roleAlias": "parent-a", "operation": "growth-transfer", "businessMetric": "business.growth.transfer", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["RECIPIENT_ALIAS", "TRANSFER_AMOUNT"], "finalProof": ["receipt", "sender-balance-readback", "recipient-balance-readback"], "compensation": "optional-return-transfer" },
    { "journeyId": "NOTE-01", "route": "/", "roleAlias": "parent-a", "operation": "notebook-write", "businessMetric": "business.notebook.write", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["PUBLIC_NOTE"], "finalProof": ["receipt", "note-readback"], "compensation": "clear-note" },
    { "journeyId": "BABY-01", "route": "/parent", "roleAlias": "parent-a", "operation": "babycoin-meal", "businessMetric": "business.babycoin.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "balance-readback", "lifetime-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "BABY-02", "route": "/parent", "roleAlias": "parent-a", "operation": "babycoin-walk", "businessMetric": "business.babycoin.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "balance-readback", "lifetime-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "BABY-03", "route": "/parent", "roleAlias": "parent-a", "operation": "babycoin-read", "businessMetric": "business.babycoin.activity", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "balance-readback", "lifetime-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "PARENT-READ-01", "route": "/parent", "roleAlias": "parent-a", "operation": "parent-readback", "transaction": "sepolia-read", "manualSignature": false, "finalProof": ["wallet-readback", "balance-readback", "stage-readback", "note-readback"], "compensation": "none" },
    { "journeyId": "MARKET-READ-01", "route": "/tasks", "roleAlias": "public", "operation": "marketplace-read", "transaction": "sepolia-read", "manualSignature": false, "finalProof": ["task-count-readback", "rpc-settled"], "compensation": "none" },
    { "journeyId": "MARKET-APPROVE-01", "route": "/tasks", "roleAlias": "parent-a", "operation": "marketplace-approve", "businessMetric": "business.marketplace.approve", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["ACTIVE_TASK_ALIAS"], "finalProof": ["receipt", "allowance-readback"], "compensation": "consume-or-revoke-allowance" },
    { "journeyId": "MARKET-BUY-01", "route": "/tasks", "roleAlias": "parent-a", "operation": "marketplace-buy", "businessMetric": "business.marketplace.buy", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["ACTIVE_TASK_ALIAS"], "finalProof": ["receipt", "purchase-readback", "provider-balance-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "CONTENT-01", "route": "/tasks", "roleAlias": "parent-a", "operation": "content-unlock", "businessMetric": "business.marketplace.content_unlock", "transaction": "worker", "manualSignature": false, "inputRefs": ["PURCHASE_ALIAS"], "finalProof": ["session-readback", "purchase-readback", "content-readback"], "compensation": "logout" },
    { "journeyId": "COMPLETE-SUBMIT-01", "route": "/tasks", "roleAlias": "parent-a", "operation": "completion-submit", "businessMetric": "business.marketplace.completion_submit", "transaction": "worker", "manualSignature": false, "inputRefs": ["PURCHASE_ALIAS", "COMPLETION_EVIDENCE", "CERTIFICATE_URI"], "finalProof": ["worker-response", "completion-readback"], "compensation": "persistent-audit-record" },
    { "journeyId": "PROVIDER-CREATE-01", "route": "/provider", "roleAlias": "provider-c", "operation": "provider-create", "businessMetric": "business.provider.create", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["TASK_METADATA_URI", "TASK_METADATA_HASH"], "finalProof": ["receipt", "pending-task-readback"], "compensation": "approve-or-reject-task" },
    { "journeyId": "OWNER-APPROVE-01", "route": "/provider", "roleAlias": "owner-relayer-d", "operation": "owner-approve", "businessMetric": "business.owner.approve", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["PENDING_TASK_ALIAS"], "finalProof": ["receipt", "vrf-settle", "active-task-readback"], "compensation": "use-task-in-purchase" },
    { "journeyId": "OWNER-REJECT-01", "route": "/provider", "roleAlias": "owner-relayer-d", "operation": "owner-reject", "businessMetric": "business.owner.reject", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["REJECT_TASK_ALIAS", "REJECTION_REASON"], "finalProof": ["receipt", "rejected-task-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "COMPLETION-LOAD-01", "route": "/provider", "roleAlias": "owner-relayer-d", "operation": "completion-load", "transaction": "worker", "manualSignature": false, "finalProof": ["session-readback", "completion-list-readback"], "compensation": "none" },
    { "journeyId": "COMPLETION-CONFIRM-01", "route": "/provider", "roleAlias": "owner-relayer-d", "operation": "completion-confirm", "businessMetric": "business.owner.completion_confirm", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["PURCHASE_ALIAS", "EVIDENCE_HASH", "CERTIFICATE_URI"], "finalProof": ["receipt", "completion-readback", "certificate-readback"], "compensation": "persistent-test-certificate" },
    { "journeyId": "KEEPSAKE-DRAW-01", "route": "/keepsakes", "roleAlias": "parent-a", "operation": "keepsake-draw", "businessMetric": "business.keepsake.draw", "transaction": "sepolia-write", "manualSignature": true, "finalProof": ["receipt", "vrf-settle", "card-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "KEEPSAKE-FUSE-01", "route": "/keepsakes", "roleAlias": "parent-a", "operation": "keepsake-fuse", "businessMetric": "business.keepsake.fuse", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["FUSION_CARD_ALIASES"], "finalProof": ["receipt", "vrf-settle", "fusion-readback"], "compensation": "persistent-test-history" },
    { "journeyId": "KEEPSAKE-RECOVER-01", "route": "/keepsakes", "roleAlias": "parent-a", "operation": "keepsake-recover", "businessMetric": "business.keepsake.recover", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["RECOVERABLE_REQUEST_ALIAS"], "finalProof": ["receipt", "recovery-readback"], "compensation": "self-compensating" },
    { "journeyId": "QUOTE-01", "route": "/exchange", "roleAlias": "parent-a", "operation": "exchange-quote", "businessMetric": "business.exchange.quote", "transaction": "sepolia-read", "manualSignature": false, "inputRefs": ["QUOTE_ASSET", "QUOTE_AMOUNT"], "finalProof": ["quote-readback"], "compensation": "none" },
    { "journeyId": "SWAP-01", "route": "/exchange", "roleAlias": "parent-a", "operation": "exchange-swap", "businessMetric": "business.exchange.swap", "transaction": "sepolia-write", "manualSignature": true, "inputRefs": ["QUOTE_ASSET", "QUOTE_AMOUNT"], "finalProof": ["receipt", "baby-balance-readback", "allowance-readback"], "compensation": "revoke-allowance" },
    { "journeyId": "IDENTITY-LOGIN-01", "route": "/profile", "roleAlias": "parent-a", "operation": "identity-login", "businessMetric": "business.identity.login", "transaction": "worker", "manualSignature": true, "finalProof": ["privy-authenticated"], "compensation": "logout" },
    { "journeyId": "IDENTITY-SESSION-01", "route": "/profile", "roleAlias": "parent-a", "operation": "identity-session", "businessMetric": "business.identity.session", "transaction": "worker", "manualSignature": true, "finalProof": ["challenge-readback", "session-readback", "profile-readback"], "compensation": "logout" },
    { "journeyId": "PROFILE-01", "route": "/profile", "roleAlias": "parent-a", "operation": "profile-write", "businessMetric": "business.profile.write", "transaction": "worker", "manualSignature": false, "inputRefs": ["NEUTRAL_USERNAME"], "finalProof": ["profile-readback", "ui-readback"], "compensation": "neutralize-profile-and-logout" },
    { "journeyId": "PERF-01", "route": "/performance", "roleAlias": "public", "operation": "performance-live", "transaction": "worker", "manualSignature": false, "finalProof": ["live-query-readback", "historical-fallback-readback"], "compensation": "clear-query-and-clean-aws" },
    { "journeyId": "EVIDENCE-01", "route": "/evidence", "roleAlias": "public", "operation": "evidence-readback", "transaction": "none", "manualSignature": false, "finalProof": ["media-readback", "link-readback", "commit-readback"], "compensation": "none" }
  ],
  "zeroOrObservedMetrics": ["longtask.duration"],
  "healthyZeroMetrics": [
    "javascript.error",
    "promise.rejection",
    "error.javascript.type_error",
    "error.javascript.network",
    "error.javascript.timeout",
    "error.javascript.unknown",
    "error.promise.type_error",
    "error.promise.network",
    "error.promise.timeout",
    "error.promise.unknown",
    "csr.fallback",
    "hydration.recoverable_error"
