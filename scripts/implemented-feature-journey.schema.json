{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://babysteps.baby2b.online/schemas/implemented-feature-journey.schema.json",
  "title": "BabySteps implemented feature journey manifest",
  "type": "array",
  "minItems": 31,
  "maxItems": 31,
  "uniqueItems": true,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "journeyId",
      "route",
      "roleAlias",
      "operation",
      "transaction",
      "manualSignature",
      "finalProof",
      "compensation"
    ],
    "properties": {
      "journeyId": { "type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{2}$" },
      "route": { "enum": ["*", "/", "/tasks", "/parent", "/keepsakes", "/provider", "/exchange", "/profile", "/performance", "/evidence"] },
      "roleAlias": { "enum": ["public", "parent-a", "recipient-b", "provider-c", "owner-relayer-d"] },
      "operation": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
      "businessMetric": { "type": "string", "pattern": "^business\\.[a-z0-9_.]+$" },
      "transaction": { "enum": ["none", "sepolia-read", "sepolia-write", "worker"] },
      "manualSignature": { "type": "boolean" },
      "inputRefs": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
      },
      "finalProof": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      },
      "compensation": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
    }
  }
}
