  "cards": [
    {
      "dot": "cyan",
      "title": "产品参与者",
      "items": [
        "访客只读；登录用户获得会话，但不会自动得到链上管理权限",
        "家长/购买者以本人钱包执行成长、购买、兑换与纪念卡操作",
        "接收者只接收代币；宝宝/孩子是业务对象，不是认证主体"
      ]
    },
    {
      "dot": "violet",
      "title": "当前 V2 权限",
      "items": [
        "PROVIDER_ROLE 创建 D1 草稿并调用 requestTask，不能自行审批",
        "DEFAULT_ADMIN_ROLE 授权 Provider、审批、拒绝与暂停；未兼任 Provider 时不能发任务",
        "COMPLETION_RELAYER_ROLE 只确认完成并触发 SBT，不能创建、审批或授权"
      ]
    },
    {
      "dot": "emerald",
      "title": "合约持有角色",
      "items": [
        "GrowthActivities 持有 BabyCoin REWARD_ROLE；Marketplace 持有证书 MINTER_ROLE",
        "StarBuddy Manager 持有纪念卡 MINTER_ROLE 与 BURNER_ROLE",
        "V1 ORACLE_ROLE 仅作历史记录；V2 使用 Chainlink VRF Coordinator 回调"
      ]
    },
    {
      "dot": "amber",
      "title": "交付与运行角色",
      "items": [
        "GitHub OIDC Deploy Role 只能进入精确项目边界并 PassRole 给精确 CFN Role",
        "临时 Stack 包含 ECS Execution、Cleaner、DB Admin、Query Lambda 四类运行角色",
        "ECS Service-linked Role 为账户级共享；Readiness/Relayer 旧路径单独标记历史或 deferred"
      ]
    }
  ]
