{
	"name": "babysteps",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.17.0",
	"scripts": {
		"check": "pnpm --filter @babysteps/contracts check && pnpm --filter @babysteps/web check && pnpm validate:standalone && pnpm validate:public-copy && pnpm validate:pages-workflow",
		"test": "pnpm test:validators && pnpm --filter @babysteps/contracts test && pnpm --filter @babysteps/web test",
		"test:validators": "node --test scripts/*.test.mjs",
		"typecheck": "pnpm --filter @babysteps/contracts typecheck && pnpm --filter @babysteps/web typecheck",
		"build": "pnpm --filter @babysteps/contracts build && pnpm --filter @babysteps/web build",
		"validate:standalone": "node scripts/validate-standalone.mjs",
		"validate:public-copy": "node scripts/validate-public-copy.mjs",
		"validate:pages-workflow": "node scripts/validate-pages-workflow.mjs",
		"validate:public-artifact": "node scripts/validate-public-artifact.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6"
	}
}
