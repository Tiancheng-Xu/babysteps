{
	"name": "@babysteps/worker",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "biome check src test vitest.config.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "WRANGLER_HIDE_BANNER=true WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir dist --x-auto-create=false",
		"types": "wrangler types worker-configuration.d.ts"
	},
	"dependencies": {
		"hono": "4.13.1",
		"viem": "2.55.13",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@cloudflare/vitest-pool-workers": "0.20.3",
		"@types/node": "catalog:",
		"typescript": "catalog:",
		"vitest": "4.1.10",
		"wrangler": "4.120.0"
	}
}
