{
	"name": "@babysteps/aws",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "biome check src test vitest.config.ts",
		"test": "vitest run",
		"typecheck": "tsc --noEmit",
		"build": "sam build --template-file template.yaml --build-dir dist --manifest lambda-package/package.json",
		"build:performance:cleaner": "esbuild src/performance/cleanerMain.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/performance/cleaner.mjs --external:pg-native",
		"build:performance:sam": "sam build --template-file performance-template.yaml --build-dir dist/performance-sam --manifest lambda-package/package.json",
		"validate": "sam validate --template-file template.yaml"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/aws-lambda": "^8.10.162",
		"@types/node": "catalog:",
		"@types/pg": "^8.21.0",
		"typescript": "catalog:",
		"vitest": "4.1.10",
		"yaml": "2.8.1"
	},
	"dependencies": {
		"@aws-sdk/client-kms": "3.1106.0",
		"@aws-sdk/client-secrets-manager": "3.1106.0",
		"@aws-sdk/client-sqs": "3.1106.0",
		"pg": "8.23.0",
		"viem": "2.55.10",
		"zod": "4.4.3"
	}
}
